<Window x:Class="ScreenTranslate.Views.FloatingButtonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مترجم الشاشة" Icon="/ScreenTranslate;component/Assets/logo.png" Width="56" Height="56" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual" FontFamily="Segoe UI Variable Text, Segoe UI">
 <Window.Resources>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F4F6FF"/><Setter Property="Background" Value="#171E2C"/><Setter Property="Padding" Value="12,7"/></Style>
 </Window.Resources>
 <Border x:Name="ButtonSurface" Width="52" Height="52" CornerRadius="15" Background="#111722" BorderBrush="#6572F5" BorderThickness="1" Cursor="Hand" PreviewMouseLeftButtonDown="Button_OnMouseLeftButtonDown" PreviewMouseMove="Button_OnMouseMove" PreviewMouseLeftButtonUp="Button_OnMouseLeftButtonUp">
  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#000000"/></Border.Effect>
  <Border.ContextMenu><ContextMenu Background="#171E2C" BorderBrush="#35405A" BorderThickness="1"><MenuItem Header="فتح البرنامج" Click="OpenProgram_OnClick"/><MenuItem x:Name="LanguageMenu" Header="تغيير اللغة"/><MenuItem Header="إخفاء الزر" Click="HideButton_OnClick"/><Separator/><MenuItem Header="خروج" Click="Exit_OnClick"/></ContextMenu></Border.ContextMenu>
  <Image Source="/ScreenTranslate;component/Assets/logo.png" Width="42" Height="42" Stretch="Uniform" IsHitTestVisible="False"/>
 </Border>
</Window>
