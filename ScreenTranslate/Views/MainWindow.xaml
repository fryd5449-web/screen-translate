<Window x:Class="ScreenTranslate.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="مترجم الشاشة" Icon="/ScreenTranslate;component/Assets/logo.png" Width="460" Height="322" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#0D111A" Foreground="#F5F7FF" FlowDirection="RightToLeft" FontFamily="Segoe UI Variable Text, Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F7F8FF"/><Setter Property="Background" Value="#252D40"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#323D55"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/></Style>
  <Style x:Key="ModernCheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="#BAC2D4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#151B29" BorderBrush="#3A455E" BorderThickness="1" Margin="0,0,9,0"><Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#5865F2"/><Setter TargetName="Box" Property="BorderBrush" Value="#7180FF"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#7180FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ComboItem" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F3F5FF"/><Setter Property="Background" Value="#151B29"/><Setter Property="Padding" Value="10,7"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#283451"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4F5FE7"/></Trigger></Style.Triggers></Style>
  <Style x:Key="DarkCombo" TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="Foreground" Value="#F3F5FF"/><Setter Property="Background" Value="#151B29"/><Setter Property="BorderBrush" Value="#303A50"/><Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="#151B29" BorderBrush="#303A50" BorderThickness="1" CornerRadius="7"/><ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><ToggleButton Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent}}"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#BFC7D8" StrokeThickness="1.5" HorizontalAlignment="Left" Margin="12,0"/></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#151B29" BorderBrush="#303A50" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border CornerRadius="14" BorderBrush="#263047" BorderThickness="1" Background="#0D111A" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Width="42" Height="42" Source="/ScreenTranslate;component/Assets/logo.png" Stretch="Uniform"/>
    <StackPanel Grid.Column="1" Margin="11,-1,0,0"><TextBlock Text="مترجم الشاشة" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Screen Translator" FontSize="10.5" Foreground="#B4BDD1" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,1,0,0"/><TextBlock Text="{Binding ProgramStatus}" Foreground="#7F8AA3" FontSize="10" Margin="0,1,0,0"/></StackPanel>
    <Button Grid.Column="2" Content="&#xE713;" ToolTip="الإعدادات" Style="{StaticResource IconButton}" Click="SettingsButton_OnClick"/>
    <Button Grid.Column="4" Content="&#xE921;" ToolTip="تصغير إلى شريط النظام" Style="{StaticResource IconButton}" Click="MinimizeToTrayButton_OnClick"/>
   </Grid>
   <Button Grid.Row="2" x:Name="SelectFromScreenButton" Height="54" Background="#5865F2" Click="SelectFromScreenButton_OnClick"><Grid Width="380"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="تحديد نص من الشاشة" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#3442C4" CornerRadius="6" Padding="9,4"><TextBlock Text="Ctrl + Shift + T" FontSize="10" Foreground="#E5E8FF" FlowDirection="LeftToRight"/></Border></Grid></Button>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="اللغة الأصلية" Foreground="#A9B1C3" FontSize="12" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding SourceLanguages}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSourceLanguage}" Style="{StaticResource DarkCombo}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="اللغة المستهدفة" Foreground="#A9B1C3" FontSize="12" Margin="0,0,0,5"/><ComboBox SelectedIndex="0" Style="{StaticResource DarkCombo}"><ComboBoxItem Content="العربية"/></ComboBox></StackPanel>
   </Grid>
   <Grid Grid.Row="6"><CheckBox x:Name="KeepOnTopCheckBox" Content="إبقاء نافذة الترجمة في المقدمة" IsChecked="{Binding KeepTranslationOnTop}" Style="{StaticResource ModernCheckBox}" Checked="KeepOnTopCheckBox_OnChecked" Unchecked="KeepOnTopCheckBox_OnChecked"/><CheckBox x:Name="StartWithWindowsCheckBox" Visibility="Collapsed" IsChecked="{Binding StartWithWindows}" Checked="StartWithWindowsCheckBox_OnChecked" Unchecked="StartWithWindowsCheckBox_OnChecked"/></Grid>
  </Grid>
 </Border>
</Window>
