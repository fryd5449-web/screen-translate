<Window x:Class="ScreenTranslate.Views.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
                Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        ShowActivated="True"
                Cursor="Cross"
        Title="SelectionOverlay" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid x:Name="RootGrid"
          MouseLeftButtonDown="RootGrid_OnMouseLeftButtonDown"
          MouseMove="RootGrid_OnMouseMove"
          MouseLeftButtonUp="RootGrid_OnMouseLeftButtonUp"
                    SizeChanged="RootGrid_OnSizeChanged"
          KeyDown="RootGrid_OnKeyDown">
        <Canvas x:Name="SelectionCanvas">
                        <Path x:Name="DimPath" Fill="#A0000000" />
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                                             Stroke="#5C7CFF"
                                             StrokeThickness="2"
                                             Fill="Transparent" />

                        <Border x:Name="SelectionSizeBadge"
                                        Visibility="Collapsed"
                                        Background="#D81A2434"
                                        BorderBrush="#4A5C7F"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4">
                                <TextBlock x:Name="SelectionSizeText"
                                                     Text="0 x 0"
                                                     Foreground="#EAF1FF"
                                                     FontSize="12"
                                                     FlowDirection="LeftToRight" />
                        </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="14,8"
                CornerRadius="8"
                Background="#B0141A24">
                        <TextBlock x:Name="HintText"
                                             Text="اسحب لتحديد النص - Esc للإلغاء"
                       Foreground="#F3F6FF"
                       FontSize="14" />
        </Border>
    </Grid>
</Window>
