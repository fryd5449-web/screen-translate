<Window x:Class="ScreenTranslate.Views.TranslationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الترجمة" Width="430" SizeToContent="Height" MaxHeight="440" MinHeight="180" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True" FlowDirection="RightToLeft" FontFamily="Segoe UI Variable Text, Segoe UI">
 <Window.Resources>
  <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Foreground" Value="#F4F6FF"/><Setter Property="Background" Value="#252E42"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="#35415A" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#34405A"/><Setter TargetName="Body" Property="BorderBrush" Value="#5865F2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#111722" BorderBrush="#313B52" BorderThickness="1" CornerRadius="15" Padding="18" MouseLeftButtonDown="RootBorder_OnMouseLeftButtonDown">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer Grid.Row="0" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"><TextBlock x:Name="TranslatedText" TextWrapping="Wrap" FontSize="19" LineHeight="31" Foreground="#FFFFFF" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/></ScrollViewer>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="نسخ الترجمة" Click="CopyTranslatedButton_OnClick" Style="{StaticResource ToolButton}"/><Button Grid.Column="2" Content="إعادة التحديد" Click="RetryButton_OnClick" Background="#5865F2" Style="{StaticResource ToolButton}"/><Button Grid.Column="4" Content="إغلاق" Click="CloseButton_OnClick" Style="{StaticResource ToolButton}"/></Grid>
  </Grid>
 </Border>
</Window>
